# AcademicNexus local configuration / 智导未来本地配置
# Copy this file to .env and replace every CHANGE_ME value.
# 复制本文件为 .env，并替换所有 CHANGE_ME 值。不得提交 .env。

COMPOSE_PROJECT_NAME=academicnexus
APP_ENV=development
APP_NAME=AcademicNexus
APP_VERSION=alpha-0917-NR
# Keep API documentation enabled only for local development. Production must set false.
API_DOCS_ENABLED=true
# The public HTTP port served by Nginx. Change this before first startup if needed.
WEB_PORT=8080
# Development API port. It is bound to 127.0.0.1 only.
API_PORT=8000

# Optional OCI image overrides. Leave unset to pull from Docker Hub.
# Set all five values to private-registry copies when Docker Hub is unreachable.
# POSTGRES_IMAGE=<registry>/academicnexus/pgvector:pg16
# REDIS_IMAGE=<registry>/academicnexus/redis:7.4-alpine
# NGINX_IMAGE=<registry>/academicnexus/nginx:1.27-alpine
# PYTHON_BASE_IMAGE=<registry>/academicnexus/python:3.13-slim
# NODE_BASE_IMAGE=<registry>/academicnexus/node:22-alpine

POSTGRES_DB=academicnexus
POSTGRES_USER=academicnexus
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_36_BYTE_BASE64URL_SECRET

# JWT signing key: at least 48 random bytes, base64url encoded.
JWT_SECRET_KEY=CHANGE_ME_USE_A_SEPARATE_RANDOM_48_BYTE_BASE64URL_SECRET
# HMAC pepper for Access Key uniqueness. Use a separate 48-byte random base64url secret.
ACCESS_KEY_PEPPER=CHANGE_ME_USE_A_SEPARATE_RANDOM_48_BYTE_BASE64URL_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# The first administrator is created exactly once on initial startup.
INITIAL_ADMIN_EMAIL=admin@academicnexus.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_SEPARATE_STRONG_PASSWORD
INITIAL_ADMIN_USERNAME=ACADEMICNEXUS_ADMIN
DEFAULT_TENANT_SLUG=academicnexus-pilot
DEFAULT_TENANT_NAME=AcademicNexus Pilot

# Comma-separated browser origins. Keep production origins explicit.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3
MINIMAX_LIGHT_MODEL=MiniMax-M2.5-highspeed
MINIMAX_STANDARD_MODEL=MiniMax-M2.7
MINIMAX_EXPERT_MODEL=MiniMax-M3
SILICONFLOW_API_KEY=
AI_DAILY_PROJECT_LIMIT=500
AI_DEFAULT_DAILY_USER_LIMIT=10
AI_DEFAULT_CREDIT_BALANCE=10
AI_CONTEXT_MESSAGE_LIMIT=16
AI_CONTEXT_CHARACTER_LIMIT=24000
AI_MAX_OUTPUT_TOKENS=1200
RESOURCE_STORAGE_PATH=/app/storage/resources
RESOURCE_MAX_UPLOAD_MB=200
MENTOR_RESOURCE_DEFAULT_QUOTA_MB=200

# Free SiliconFlow models; keys stay on the backend.
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RANKING_ENABLED=true
RANKING_TIMEOUT_SECONDS=15
RANKING_CANDIDATE_LIMIT=200
RANKING_RERANK_LIMIT=40
RANKING_CACHE_TTL_SECONDS=900
RANKING_EMBEDDING_TTL_DAYS=30
